# Ethereum mainnet (chainId 1) — squid network env.
#
# Copy this to .env.ethereum and fill in the secrets. The actual file is
# gitignored — DO NOT COMMIT it. Mirrors .env.flare / .env.plume / .env.berachain.
#
# Used by:
#   - squid-typeorm-migration  (DB_*)
#   - squid-graphql-server     (DB_*, GQL_PORT)
#   - src/processor.ts + main.ts (NETWORK, MORPHO_BLUE_ADDRESS, PUBLIC_ALLOCATOR_ADDRESS,
#                                 RPC_ENDPOINT, START_BLOCK, PORTAL_URL, VAULT_ADDRESSES)

NETWORK=ETHEREUM

# Morpho on Ethereum: https://docs.morpho.org/developers/contracts/addresses/
#   Morpho Blue (core singleton) and Public Allocator. MetaMorpho/VaultV2 events
#   are indexed by topic, so their factories are not needed here.
# Verified on-chain: PublicAllocator.MORPHO() == the Morpho Blue address below.
MORPHO_BLUE_ADDRESS=0xBBBBBbbBBb9cC5e90e3b3Af64bdAF62C37EEFFCb
PUBLIC_ALLOCATOR_ADDRESS=0xfd32fA2ca22c76dD6E550706Ad913FC6CE91c75D

# JSON-RPC endpoint — used for contract state reads the portal can't provide.
# A public endpoint will rate-limit badly on a chain this size; use a paid one.
RPC_ENDPOINT=https://ethereum-rpc.publicnode.com

# Portal dataset (Ethereum has one, so ingestion is portal-based like FLARE/PLUME).
# Override only for a private portal; otherwise processor.ts resolves it from NETWORK.
# PORTAL_URL=https://portal.sqd.dev/datasets/ethereum-mainnet

# Morpho Blue's deployment block on Ethereum (2023-12-28), confirmed by binary
# search on eth_getCode. Nothing Morpho-related exists before it.
START_BLOCK=18883124

# ── Narrow escape hatch — NOT the answer for Morpho-wide indexing here ─────
# Comma-separated vault allowlist. Leave unset unless this deployment tracks a
# fixed, known set of vaults.
#
# Leaving it unset means MetaMorpho/VaultV2 logs match by topic on every
# address, and two of those topics are ERC4626 Deposit/Withdraw, which every
# ERC4626 vault on mainnet emits — a large amount of irrelevant log traffic,
# each log reaching identifyVault, which costs up to 3 RPC calls the first time
# it sees an address (cached in memory only, so a restart re-probes). That cost
# is real and unsolved on this chain; see README "Vault discovery cost".
#
# Setting it does NOT fix that in general: Morpho has ~450 MetaMorpho vaults on
# Ethereum, and the filter is fixed at process start, so vaults created later
# are silently missed until someone edits this and restarts.
# VAULT_ADDRESSES=0xvault1,0xvault2

# RPC tuning (portal path reads little from RPC; raise only if state reads throttle).
RPC_RATE_LIMIT=100
RPC_CAPACITY=100

# Postgres connection.
DB_NAME=morpho_ethereum
DB_HOST=localhost
DB_PORT=5437
DB_USER=postgres
DB_PASS=

# GraphQL server port. 4350–4354 are taken by the other networks.
GQL_PORT=4355

# ── API-key guard for this network's GraphQL API (npm run serve:ethereum) ──
# OFF (default) = open. "true" = require a valid key on POST, checked as
# sha256(key) against the morpho_api_keys collection. Same flag/vars on every
# .env.<network>. When on, MORPHO_MONGO_URI is required.
MORPHO_API_KEY_GUARD=false
MORPHO_MONGO_URI=
MORPHO_MONGO_DB=
MORPHO_API_KEYS_COLLECTION=morpho_api_keys
