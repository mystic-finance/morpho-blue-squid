# Canton (Mystic) — squid network env.
#
# Copy this to .env.canton and fill in the secrets. The actual file is
# gitignored — DO NOT COMMIT it.
#
# Used by:
#   - squid-typeorm-migration  (DB_*)
#   - squid-graphql-server     (DB_*, GQL_PORT)
#   - src/canton/main.ts       (NETWORK, CANTON_*, FIVENORTH_*)
#
# Mirrors the pattern of .env.flare / .env.plume / .env.citrea. Network
# selector is `NETWORK=CANTON` — main.ts checks this and routes to the
# Canton processor instead of the EVM batch processor.

NETWORK=CANTON

# Canton sub-network selector. `devnet` (default) → -v3 templates + FiveNorth
# OAuth + `canton-indexer` state row. `testnet` → -v5 templates + unsafe HS256
# auth + `canton-indexer-testnet` state row. Devnet is the default so an
# existing .env.canton keeps behaving exactly as before. See
# .env.canton.testnet.example for the testnet counterpart of this file.
CANTON_NETWORK=devnet

# Canton Ledger API v2 (JSON over HTTPS). Devnet today; swap when promoting
# to testnet/mainnet. The processor strips a trailing /v2 if present so both
# forms work, but match what the backend already uses for consistency.
CANTON_API_URL=https://ledger-api.validator.devnet.sandbox.fivenorth.io/v2

# Public party that owns the view of every Market/Position contract. Same
# party the existing backend uses for ACS reads.
CANTON_PUBLIC_PARTY=

# FiveNorth client_credentials grant. Same values the backend uses — these
# are validator machine-to-machine credentials. Get them from the same
# secrets store the backend reads. Devnet only (CANTON_NETWORK=devnet).
FIVENORTH_CLIENT_ID=
FIVENORTH_CLIENT_SECRET=
FIVENORTH_AUDIENCE=

# Testnet unsafe HS256 auth (only read when CANTON_NETWORK=testnet). Mystic's
# own validator accepts symmetric-key tokens: HS256({ iat, aud, sub }, secret)
# with no exp.
#   CANTON_TESTNET_AUTH_AUDIENCE  JWT `aud`  (default https://ledger_api.example.com)
#   CANTON_TESTNET_AUTH_SECRET    HMAC key   (default `unsafe`)
#   CANTON_TESTNET_AUTH_SUBJECT   JWT `sub`  (default = CANTON_PUBLIC_PARTY prefix before `::`)
CANTON_TESTNET_AUTH_AUDIENCE=https://ledger_api.example.com
CANTON_TESTNET_AUTH_SECRET=unsafe
CANTON_TESTNET_AUTH_SUBJECT=

# Postgres connection.
#
# Local dev (brew install postgresql@15): port 5432 with peer/password auth
# on the `postgres` role. This is the default brew install and what
# `npm run migration:generate:canton` / `npm run process:canton` will target.
#
# Dockerized deploy via `docker compose up processor_canton`: the
# processor_canton service overrides DB_HOST=db_canton via the compose
# environment block, so the port-5432-on-localhost setting here is ignored.
DB_NAME=morpho_canton
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASS=

# GraphQL server port. 4350/4351/4352 are taken by the EVM networks.
GQL_PORT=4353

# Indexer tuning knobs (override as needed in prod):
#   CANTON_INDEXER_BATCH_SIZE       max events per /v2/updates/flats call
#   CANTON_INDEXER_POLL_INTERVAL_MS poll cadence once caught up to ledger end
CANTON_INDEXER_BATCH_SIZE=200
CANTON_INDEXER_POLL_INTERVAL_MS=3000
