# Canton (Mystic) — TESTNET squid network env.
#
# Copy this to .env.canton.testnet and fill in the secrets. Runs a SECOND,
# additive Canton processor alongside the devnet one (.env.canton), reading
# Mystic's own testnet validator on the -v5 DARs with unsafe HS256 auth. The
# devnet processor is untouched.
#
#   node lib/main.js  with these vars  →  testnet processor (-v5)
#   node lib/main.js  with .env.canton →  devnet processor  (-v3)
#
# Because CANTON_NETWORK=testnet the processor auto-selects: -v5 templates,
# UnsafeTokenAuth, and the `canton-indexer-testnet` state row — so its resume
# offset never collides with devnet's `canton-indexer` row.

NETWORK=CANTON
CANTON_NETWORK=testnet

# Mystic testnet validator JSON Ledger API v2 (unsafe/local). The processor
# strips a trailing /v2 if present.
CANTON_API_URL=http://json-ledger-api.localhost:8081

# Public party that owns the view of every Market/Position contract on testnet.
CANTON_PUBLIC_PARTY=MysticProvider::1220b9852e2a328c648df0b5aedf2a73091311fac051e8d58842f633234e88e44462

# Unsafe HS256 auth. `sub` defaults to the CANTON_PUBLIC_PARTY prefix before
# `::` (MysticProvider); override with CANTON_TESTNET_AUTH_SUBJECT if needed.
CANTON_TESTNET_AUTH_AUDIENCE=https://ledger_api.example.com
CANTON_TESTNET_AUTH_SECRET=unsafe
CANTON_TESTNET_AUTH_SUBJECT=

# Postgres connection — a SEPARATE database from devnet's morpho_canton so the
# -v5 tables never mix with -v3. Matches gateway-config.json's CANTON chain.
DB_NAME=morpho_canton_testnet
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASS=

# GraphQL server port. 4353 is devnet Canton; testnet gets its own.
GQL_PORT=4356

# Indexer tuning knobs (override as needed in prod).
CANTON_INDEXER_BATCH_SIZE=200
CANTON_INDEXER_POLL_INTERVAL_MS=3000

# ── Gateway (morpho-shaped read API) — CANTON chain DB, id 424242 ──
# The gateway resolves these when serving gateway-config.json's CANTON chain.
GATEWAY_DB_HOST_CANTON=localhost
GATEWAY_DB_PORT_CANTON=5432
GATEWAY_DB_PASS_CANTON=
