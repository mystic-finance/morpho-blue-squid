# Berachain (chainId 80094) — squid network env.
#
# Copy this to .env.berachain and fill in the secrets. The actual file is
# gitignored — DO NOT COMMIT it. Mirrors .env.flare / .env.plume.
#
# Used by:
#   - squid-typeorm-migration  (DB_*)
#   - squid-graphql-server     (DB_*, GQL_PORT)
#   - src/processor.ts + main.ts (NETWORK, MORPHO_BLUE_ADDRESS, PUBLIC_ALLOCATOR_ADDRESS,
#                                 RPC_ENDPOINT, START_BLOCK, PORTAL_URL)

NETWORK=BERACHAIN

# Morpho on Berachain (branded "Bend"): https://docs.berachain.com/build/bend/deployed-contracts
#   Morpho Blue (core singleton) and Public Allocator. MetaMorpho/VaultV2 events
#   are indexed address-unfiltered, so their factories are not needed here.
MORPHO_BLUE_ADDRESS=0x24147243f9c08d835C218Cda1e135f8dFD0517D0
PUBLIC_ALLOCATOR_ADDRESS=0xB62F34Ab315eaDeAc698e8EaEB6Fc2650951BFe7

# JSON-RPC endpoint — used for contract state reads the portal can't provide.
RPC_ENDPOINT=https://rpc.berachain.com

# Portal dataset (Berachain has one, so ingestion is portal-based like FLARE/PLUME).
# Override only for a private portal; otherwise processor.ts resolves it from NETWORK.
# PORTAL_URL=https://portal.sqd.dev/datasets/berachain-mainnet

# Start from the Morpho Blue deployment block on Berachain to avoid scanning
# empty history. 0 works but syncs from genesis. Set to the actual deploy block.
START_BLOCK=0

# ── RPC tuning ────────────────────────────────────────────────────────────
# The portal supplies logs, but the mapping still makes a lot of contract
# state reads (ERC20 metadata, vault probing, oracle feeds, position reads),
# so these are NOT decorative on a large chain.
#
# RPC_RATE_LIMIT is requests/second and RPC_CAPACITY the concurrency cap. Set
# them to what the endpoint's plan actually allows, with headroom. Too high is
# not "fast" — it is a permanent 429 loop, and a batch that never finishes
# never commits, so the indexer's recorded height stops advancing entirely.
#
# Reference points for a free dRPC key (as of 2026-08): ~2,100 CU/s, roughly
# 100 eth_call/s nominally, degrading to a ~40 eth_call/s floor under regional
# load — plus a hard 210M CU per 30 days quota. That quota is the one that
# bites an indexer: it is ~10M eth_calls, and exhausting it returns the same
# "rate limit" error until the period resets, whatever these values say.
# A free key is not viable for Base or Ethereum. Use a paid endpoint.
RPC_RATE_LIMIT=10
RPC_CAPACITY=10

# JSON-RPC batch size for the RPC-only ingestion path. Providers cap this and
# reject oversized batches; dRPC's free plan allows only 3 items. Raise on a
# paid plan that documents a higher limit.
RPC_MAX_BATCH_CALL_SIZE=3

# Postgres connection.
DB_NAME=morpho_berachain
DB_HOST=localhost
DB_PORT=5436
DB_USER=postgres
DB_PASS=

# GraphQL server port. 4350/4351/4352/4353 are taken by the other networks.
GQL_PORT=4354

# ── API-key guard for this network's GraphQL API (npm run serve:berachain) ──
# OFF (default) = open. "true" = require a valid key on POST, checked as
# sha256(key) against the morpho_api_keys collection. Same flag/vars on every
# .env.<network>. When on, MORPHO_MONGO_URI is required.
MORPHO_API_KEY_GUARD=false
MORPHO_MONGO_URI=
MORPHO_MONGO_DB=
MORPHO_API_KEYS_COLLECTION=morpho_api_keys
