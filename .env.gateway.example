# Gateway (Morpho-shaped read API) — copy to .env.gateway and fill in.
#
# The gateway is read-only: it opens no write connection, runs no migrations,
# and starts/stops independently of the indexer processes.
#
# Used by: src/gateway/* (via `npm run serve:gateway`)

GATEWAY_PORT=4360
GATEWAY_PATH=/gateway

# morpho-gateway — a second read endpoint speaking the Morpho blue-api schema
# verbatim (npm run serve:morpho-gateway). Shares this same file and
# gateway-config.json; only its port/path differ.
MORPHO_GATEWAY_PORT=4370
MORPHO_GATEWAY_PATH=/graphql

# Restrict CORS in production; defaults to * for local development.
GATEWAY_CORS_ORIGIN=*

# ── API-key guard ──────────────────────────────────────────────────────────
# Single on/off flag. OFF (default) = every request allowed, no key needed and
# no Mongo connection opened. Set to "true" to require a valid key (checked as
# sha256(key) against the morpho_api_keys collection) on POST data requests to
# both gateways and the guarded squid GraphQL servers. Keys are minted/renewed
# by the backend MorphoApiKeyService; send one as `x-api-key` or
# `Authorization: Bearer <key>`. GET console + /health stay open either way.
MORPHO_API_KEY_GUARD=false
MORPHO_MONGO_URI=
# Optional: database name (defaults to the one in the URI) and collection name.
MORPHO_MONGO_DB=
MORPHO_API_KEYS_COLLECTION=morpho_api_keys

# Path to the chain/metadata registry. Defaults to ./gateway-config.json.
# GATEWAY_CONFIG_PATH=./gateway-config.json

# Pin this instance to a subset of the chains in gateway-config.json, by their
# `key`. Unset = serve every configured chain and let callers scope with
# `where: { chainId_in: [...] }`. Set it when you want an endpoint that is
# structurally unable to read another chain's database.
# GATEWAY_CHAINS=FLARE

# Per-chain database credentials, referenced as ${VAR} from gateway-config.json.
GATEWAY_DB_HOST_FLARE=localhost
GATEWAY_DB_PORT_FLARE=5432
GATEWAY_DB_PASS_FLARE=

GATEWAY_DB_HOST_PLUME=localhost
GATEWAY_DB_PORT_PLUME=5433
GATEWAY_DB_PASS_PLUME=

GATEWAY_DB_HOST_CITREA=localhost
GATEWAY_DB_PORT_CITREA=5434
GATEWAY_DB_PASS_CITREA=

GATEWAY_DB_HOST_BERACHAIN=localhost
GATEWAY_DB_PORT_BERACHAIN=5436
GATEWAY_DB_PASS_BERACHAIN=

GATEWAY_DB_HOST_ETHEREUM=localhost
GATEWAY_DB_PORT_ETHEREUM=5437
GATEWAY_DB_PASS_ETHEREUM=

GATEWAY_DB_HOST_BASE=localhost
GATEWAY_DB_PORT_BASE=5438
GATEWAY_DB_PASS_BASE=

# Per-chain JSON-RPC endpoints, used only for live balanceOf reads (wallet
# holdings on position queries). Optional — a chain left blank reports its
# wallet holdings as null rather than erroring.
GATEWAY_RPC_FLARE=
GATEWAY_RPC_PLUME=
GATEWAY_RPC_CITREA=
GATEWAY_RPC_BERACHAIN=https://rpc.berachain.com
GATEWAY_RPC_ETHEREUM=https://ethereum-rpc.publicnode.com
GATEWAY_RPC_BASE=https://base-rpc.publicnode.com

# Tuning.
#   GATEWAY_DB_POOL_SIZE     max pg connections per chain
#   GATEWAY_HISTORY_LIMIT    max buckets returned per historical.daily/hourly
GATEWAY_DB_POOL_SIZE=8
GATEWAY_HISTORY_LIMIT=1000
