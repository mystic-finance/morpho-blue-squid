# Base (chainId 8453) — squid network env.
#
# Copy this to .env.base and fill in the secrets. The actual file is
# gitignored — DO NOT COMMIT it. Mirrors .env.flare / .env.plume / .env.berachain.
#
# Used by:
#   - squid-typeorm-migration  (DB_*)
#   - squid-graphql-server     (DB_*, GQL_PORT)
#   - src/processor.ts + main.ts (NETWORK, MORPHO_BLUE_ADDRESS, PUBLIC_ALLOCATOR_ADDRESS,
#                                 RPC_ENDPOINT, START_BLOCK, PORTAL_URL, VAULT_ADDRESSES)

NETWORK=BASE

# Morpho on Base: https://docs.morpho.org/developers/contracts/addresses/
#   Morpho Blue is deployed at the same address as on Ethereum; the Public
#   Allocator is not. MetaMorpho/VaultV2 events are indexed by topic, so their
#   factories are not needed here.
# Verified on-chain: PublicAllocator.MORPHO() == the Morpho Blue address below.
MORPHO_BLUE_ADDRESS=0xBBBBBbbBBb9cC5e90e3b3Af64bdAF62C37EEFFCb
PUBLIC_ALLOCATOR_ADDRESS=0xA090dD1a701408Df1d4d0B85b716c87565f90467

# JSON-RPC endpoint — used for contract state reads the portal can't provide.
# A public endpoint will rate-limit badly on a chain this size; use a paid one.
RPC_ENDPOINT=https://base-rpc.publicnode.com

# Portal dataset (Base has one, so ingestion is portal-based like FLARE/PLUME).
# Override only for a private portal; otherwise processor.ts resolves it from NETWORK.
# PORTAL_URL=https://portal.sqd.dev/datasets/base-mainnet

# Morpho Blue's deployment block on Base (2024-05-03), confirmed by binary
# search on eth_getCode. Nothing Morpho-related exists before it.
START_BLOCK=13977148

# ── STRONGLY RECOMMENDED ON THIS CHAIN ─────────────────────────────────────
# Comma-separated vault allowlist. Without it, MetaMorpho/VaultV2 logs are
# matched by topic on every address — and two of those topics are ERC4626
# Deposit/Withdraw, which every ERC4626 vault on Base emits. That is a large
# amount of irrelevant log traffic plus one identifyVault RPC probe per distinct
# address (cached afterwards). Pin it to the vaults you actually index:
# VAULT_ADDRESSES=0xvault1,0xvault2

# RPC tuning (portal path reads little from RPC; raise only if state reads throttle).
RPC_RATE_LIMIT=100
RPC_CAPACITY=100

# Postgres connection.
DB_NAME=morpho_base
DB_HOST=localhost
DB_PORT=5438
DB_USER=postgres
DB_PASS=

# GraphQL server port. 4350–4355 are taken by the other networks.
GQL_PORT=4356

# ── API-key guard for this network's GraphQL API (npm run serve:base) ──
# OFF (default) = open. "true" = require a valid key on POST, checked as
# sha256(key) against the morpho_api_keys collection. Same flag/vars on every
# .env.<network>. When on, MORPHO_MONGO_URI is required.
MORPHO_API_KEY_GUARD=false
MORPHO_MONGO_URI=
MORPHO_MONGO_DB=
MORPHO_API_KEYS_COLLECTION=morpho_api_keys
