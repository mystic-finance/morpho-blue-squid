  "_tokens_comment": "chainId -> token address -> off-chain metadata the indexer cannot observe. `name` overrides the on-chain name when set.",
  "tokens": {
    "14": {},
    "98866": {},
    "5115": {}
  },

  "_curators_comment": "Curator address -> public profile, surfaced as vault.metadata.curators.",
  "curators": {},

  "_irm_comment": "chainId -> IRM address -> curve params. Anything not listed uses defaultIrm.",
  "irm": {
    "14": {},
    "98866": {},
    "5115": {}
  },

  "defaultIrm": {
    "type": "adaptive-curve",
    "targetUtilization": 0.9,
    "curveSteepness": 4
  }
